# Copy to .env (gitignored) and fill in the placeholders. Mirrors every var the harness reads.
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ TEX MEMORY IS PRE-WIRED.  Tex (by MetaCognition) is our own product and is    │
# │ NOT publicly available, so we ship a working Tex key + URL below so you can    │
# │ run the `tex` memory backend out of the box (MEMORY_BACKEND=tex).             │
# │ Everything else (Groq / OpenAI-Azure / HydraDB) uses publicly obtainable keys │
# │ — fill in your own.                                                            │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── GRADED BRAIN (the LLM) ────────────────────────────────────────────────────
# LLM_API="chat" = OpenAI-compatible chat/completions (Groq, Gemini gateway, Ollama, ...)
# LLM_API="responses" = Azure/OpenAI Responses API (e.g. GPT-5.5)
LLM_API=chat
MODEL=llama-3.3-70b-versatile          # set to whatever model is being graded

# Chat path (publicly available — bring your own):
GROQ_API_KEY=                          # <-- your key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── EMBEDDINGS + (optional) Responses path ────────────────────────────────────
# Always needed for the `local` memory backend (embeds demos). Publicly available.
OPENAI_API_KEY=                        # <-- your OpenAI/Azure key
OPENAI_BASE_URL=                       # blank = api.openai.com ; or your Azure v1 endpoint
EMBED_MODEL=text-embedding-3-large

# ── TEX MEMORY (our product — PRE-WIRED, ready to use) ────────────────────────
# Enable with MEMORY_BACKEND=tex below. The 'appworld-gold' session is pre-ingested
# with all 147 gold demos, so you can set TEX_SKIP_INGEST=1 for instant startup.
TEX_API_KEY=tex_live_Mf6XrjGIUVjywDPWlCnJ3xtc81yGNsefxa7jQ6B7Qlc
TEX_BASE_URL=https://api.getmetacognition.com
TEX_ORG_ID=org_mF0ruq0ijCAb63Rj
TEX_USER_ID=apikey_52543c34
TEX_SESSION_ID=appworld-gold
TEX_SKIP_INGEST=0                      # set 1 to reuse the pre-ingested session (no re-upload)

# ── HYDRADB MEMORY (bonus backend — publicly available, bring your own) ────────
HYDRADB_API_KEY=                       # <-- your key (enable with MEMORY_BACKEND=hydra)
HYDRADB_BASE_URL=https://api.hydradb.com

# ── MEMORY / RETRIEVAL ────────────────────────────────────────────────────────
MEMORY_BACKEND=local                   # local | tex | hydra
K_DEMOS=2
SEED_SPLITS=train,dev                  # "train" only = leak-free dev eval; "train,dev" = test run

# ── RUN CONFIG ────────────────────────────────────────────────────────────────
# APPWORLD_EXPERIMENT=team_yourname     # unique id
# APPWORLD_DATASET=dev                  # dev | test_normal | test_challenge
# MAX_TASKS=0                           # 0 = all
# MAX_INTERACTIONS=40                   # max ReAct turns per task

# (legacy starter var; unused)
ANTHROPIC_API_KEY=
